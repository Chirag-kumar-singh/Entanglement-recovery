# Training logs: keep diagnostic-experiment logs, but drop heavy RSL-RL
# training artifacts except the single frozen walking-policy checkpoint
# (DEFAULT_WALK_CHECKPOINT) needed to reproduce recovery experiments
# without retraining the base walking policy.
logs/rsl_rl/*
!logs/rsl_rl/go2_velocity/
logs/rsl_rl/go2_velocity/*
